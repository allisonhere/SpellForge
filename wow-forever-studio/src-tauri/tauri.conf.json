{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Forever Studio",
  "version": "0.1.0",
  "identifier": "dev.wowforeverstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "WoW Forever Studio", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage", "nsis"], "icon": ["icons/32x32.png", "icons/icon.png"], "license": "MIT" }
}
